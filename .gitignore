# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 数据库与日志(属于数据/运行产物，不纳入代码存档)
/data/*.db
data.db
*.log
feishu-debug.log

# 抖音采集的浏览器登录态(含cookie，勿提交)
/data/douyin-profile/

# ---- 演示版的隐私加固（原 .gitignore 只忽略了 /data/*.db，覆盖不到子目录）----
/data/uploads/
/data/backups/
/data/screenshots/
/data/videos/
/data/avatars/
/data/users/
/data/**/*.db
/data/**/*.db-wal
/data/**/*.db-shm
/data/douyin-profile/
.env
.env.*
